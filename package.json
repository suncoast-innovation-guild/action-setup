{
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=4.0.4",
      "fast-xml-parser": ">=5.7.0 <6",
      "undici": ">=7.24.0 <8"
    },
    "auditConfig": {
