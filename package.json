    "expand-tilde": "^2.0.2",
    "yaml": "^2.9.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "globals": "^16.0.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.19.1"
  }
