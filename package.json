{
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=4.0.4",
      "fast-xml-parser": ">=5.3.4",
      "undici": ">=6.23.0"
    }
  },
  "scripts": {
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js --loader:.json=json",
    "build": "pnpm run build:bundle",
    "start": "pnpm run build && sh ./run.sh",
    "update-bootstrap": "node scripts/update-bootstrap.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@actions/cache": "^4.1.0",
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@actions/glob": "^0.5.0",
    "@types/expand-tilde": "^2.0.2",
    "@types/node": "^22.0.0",
    "expand-tilde": "^2.0.2",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "esbuild": "^0.27.4",
    "eslint": "^9.17.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.19.1"
  }
}
